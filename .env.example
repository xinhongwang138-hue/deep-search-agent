# ===== 模型 =====
DS_AGENT_MODEL=openai:gpt-4o-mini
# 走 OpenAI 兼容网关时填写（留空则使用原生 provider）
DS_AGENT_MODEL_BASE_URL=
DS_AGENT_MODEL_API_KEY=
# 子智能体可指定更便宜的模型，留空则沿用主模型
DS_AGENT_SUBAGENT_MODEL=

# ===== 网络检索 =====
TAVILY_API_KEY=

# ===== 企业数据库（只读账号）=====
DS_AGENT_DB_URL=mysql+pymysql://readonly:password@127.0.0.1:3306/business

# ===== RAGFlow 知识库 =====
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=

# ===== 运行参数 =====
DS_AGENT_WORKSPACE_ROOT=./workspaces
MAX_SEARCHES_PER_QUESTION=3
SQL_MAX_ROWS=200
SQL_TABLE_PREVIEW_ROWS=100
MAX_SQL_FIX_ATTEMPTS=1
MAX_FILE_READ_BYTES=2097152
# 文档解析上限（PDF 页数 / Excel 预览行数）
DOC_MAX_PAGES=200
DOC_MAX_ROWS=30
